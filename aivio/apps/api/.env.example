NODE_ENV=development
PORT=8788

# Local SQLite. Prisma resolves this to apps/api/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# start-local.ps1 replaces this placeholder with a random local secret on first run.
JWT_SECRET=your_jwt_secret_here

# Local browser origins.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
GENERATION_RATE_LIMIT_MAX=30
MOCK_PAY_RATE_LIMIT_MAX=30
ENABLE_MOCK_PAYMENT=false

# Email verification. Development can use the dev verification-code fallback when delivery is not configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_PROVIDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=

# Local asset storage.
UPLOAD_RETENTION_DAYS=7
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100
PUBLIC_ASSET_BASE_URL=

# Optional R2 image storage. Leave all fields empty to keep images local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
R2_REGION=auto

# Provider request settings.
AGNES_REQUEST_TIMEOUT_MS=60000

# AI provider keys. Keep empty until the corresponding provider is used.
VOLCENGINE_ARK_API_KEY=
AGNES_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GITHUB_MODELS_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
