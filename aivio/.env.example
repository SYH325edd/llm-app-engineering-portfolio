NODE_ENV=development
PORT=8788

# Database and auth secrets
# Prisma SQLite path is resolved from apps/api/prisma/schema.prisma.
# file:./dev.db maps to apps/api/prisma/dev.db for local development.
DATABASE_URL="file:./dev.db"
JWT_SECRET=replace_with_a_long_random_local_secret

# Frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Test-only mock payment switch. Use true only in local/test environments.
# Production must keep this false.
ENABLE_MOCK_PAYMENT=false

# Email verification via SMTP only. This is not Google OAuth and does not require the Gmail API.
# Gmail SMTP usually uses 587 with STARTTLS or 465 with SMTP_SECURE=true.
# Personal Gmail accounts usually need Google two-step verification and an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_email@example.com
SMTP_PASS=your_gmail_app_password_or_smtp_password_here
SMTP_FROM="AIVio <your_sender_email@example.com>"

# Production must configure SMTP when email verification is enabled.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10

# Temporary local upload retention window in days. Invalid, zero, or negative values fall back to 7 days.
UPLOAD_RETENTION_DAYS=7

# Optional public base URL for uploaded assets. Leave empty in local-only development.
# When missing, external models may not be able to access locally uploaded assets.
PUBLIC_ASSET_BASE_URL=

# Agnes request timeout in milliseconds. Missing or invalid values fall back to 60000.
AGNES_REQUEST_TIMEOUT_MS=60000

# Video / prompt provider keys (use fake placeholder values here only)
VOLCENGINE_ARK_API_KEY=your_volcengine_ark_api_key_here
AGNES_API_KEY=your_agnes_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
GITHUB_MODELS_API_KEY=your_github_models_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
