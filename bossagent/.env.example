LAKEJOB_DATABASE_URL=postgresql://lakejob_user:lakejob_pass@localhost:5432/lakejob_db
LAKEJOB_AI_API_KEY=your_ai_key_here
LAKEJOB_REAL_RUN_CONFIG=config/real_run_config.yaml
LAKEJOB_USER_ID=
LAKEJOB_ORGANIZATION_ID=
LAKEJOB_USER_ROLE=jobseeker
LAKEJOB_TRUST_IDENTITY_HEADERS=false
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
USE_VISION_SEARCH=true
ALLOW_LEGACY_DOM_SEARCH=false
