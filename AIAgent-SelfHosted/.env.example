# AIAgent Self-Hosted 生产环境变量模板。
# 复制为 .env 后只在服务器填写真实值；.env 已被 Git 忽略，禁止提交或发送给他人。

# ============================================================
# 基础运行
# ============================================================
NODE_ENV=production
PUBLIC_BASE_URL=https://api.xueqgg.com.cn
SESSION_TTL_SECONDS=604800
MAX_UPLOAD_BYTES=20971520
MAINTENANCE_INTERVAL_MS=21600000
GENERATED_FILE_RETENTION_DAYS=90

# 下面 4 项都在服务器执行 `openssl rand -hex 32` 分别生成，不要复用。
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX
FILE_SIGNING_SECRET=REPLACE_WITH_RANDOM_64_HEX
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_64_HEX
GRADING_WORKER_TOKEN=REPLACE_WITH_RANDOM_64_HEX

# ============================================================
# 微信小程序服务端登录
# ============================================================
WECHAT_APP_ID=wx70931eca66e598fa
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET

# ============================================================
# 数据库初始化（仅首次初始化使用；完成后建议轮换/移除）
# ============================================================
DATABASE_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_64_HEX

# ============================================================
# gradingWorker
# ============================================================
GRADING_WORKER_CONCURRENCY=5
GRADING_WORKER_QUEUE_LIMIT=100
GRADING_WORKER_LEASE_MS=300000
GRADING_WORKER_HEARTBEAT_MS=30000
GRADING_WORKER_SHUTDOWN_GRACE_MS=30000
GRADING_WORKER_ENQUEUE_TIMEOUT_MS=5000

# ============================================================
# 火山方舟 Ark
# ============================================================
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MINI_ENDPOINT=
ARK_LITE_ENDPOINT=
ARK_MINI_MODEL=
ARK_LITE_MODEL=
ARK_MINI_MAX_OUTPUT_TOKENS=6500
ARK_LITE_MAX_OUTPUT_TOKENS=4096
ARK_MINI_API_MODE=chat_completions
ARK_LITE_API_MODE=responses
ARK_ENABLE_JSON_MODE=false
ARK_REQUEST_TIMEOUT_MS=300000
ARK_NARRATION_TIMEOUT_MS=45000
ENABLE_VERBOSE_LOGS=false

# ============================================================
# 百炼 / Qwen（难题训练通道）
# QWEN_API_KEY 与 DASHSCOPE_API_KEY 二选一，优先读取 QWEN_API_KEY。
# ============================================================
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# ============================================================
# TTS
# ============================================================
TTS_API_KEY=
TTS_RESOURCE_ID=seed-tts-2.0
TTS_SPEAKER=
TTS_AUDIO_FORMAT=mp3
TTS_SAMPLE_RATE=24000
TTS_BIT_RATE=128000
TTS_TIMEOUT_MS=45000

# ============================================================
# Strategy 授权
# ============================================================
# customerId / licenseId / appIdHash / license key / public key
# 由容器启动时从 strategy/private 自动加载，不需要重复填写到 .env。
STRATEGY_REMOTE_REQUIRED=true
STRATEGY_SERVICE_TIMEOUT_MS=8000
STRATEGY_CACHE_REFRESH_DAYS=7
STRATEGY_CLIENT_CONTRACT_VERSION=1

# ============================================================
# 可选：难题训练 Provider
# 留空时：配置了 QWEN 时自动使用 Qwen，否则回退 Ark Lite。
# ============================================================
HARD_PROBLEM_TRAINING_PROVIDER=

# ============================================================
# 可选：Review 临时通道
# 正式不用时保持 false / 留空即可。
# ============================================================
REVIEW_CHANNEL_ENABLED=false
REVIEW_ACCESS_CODE_HASH=
REVIEW_CHANNEL_EXPIRES_AT=
