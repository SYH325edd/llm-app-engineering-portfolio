.privacy-mask{position:fixed;z-index:9999;top:0;right:0;bottom:0;left:0;display:flex;align-items:center;justify-content:center;padding:40rpx;background:rgba(25,32,52,.48);box-sizing:border-box}.privacy-panel{width:100%;max-width:650rpx;padding:38rpx 34rpx 30rpx;border-radius:30rpx;background:#fff;box-sizing:border-box;box-shadow:0 20rpx 60rpx rgba(28,39,79,.2)}.privacy-title{color:#26334d;font-size:34rpx;font-weight:700;text-align:center}.privacy-text{margin-top:24rpx;color:#667085;font-size:27rpx;line-height:1.75}.privacy-link{margin-top:18rpx;color:#526df5;font-size:26rpx;text-align:center}.privacy-actions{display:grid;grid-template-columns:1fr 1.35fr;gap:16rpx;margin-top:30rpx}.privacy-actions button{height:82rpx;border:0;border-radius:20rpx;font-size:27rpx;line-height:82rpx}.privacy-actions button::after{border:0}.privacy-cancel{background:#f1f3f8;color:#667085}.privacy-agree{background:#526df5;color:#fff}
