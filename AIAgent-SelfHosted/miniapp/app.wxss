page {
  --ui-primary: #526df5;
  --ui-primary-deep: #493cf5;
  --ui-page-bg: #f5f7fc;
  --ui-card: #ffffff;
  --ui-text: #172033;
  --ui-muted: #7c879c;
  --ui-line: #e9edf6;
  --ui-success: #20b96d;
  --ui-warning: #ff9d14;
  --ui-danger: #ff5b61;
  background: var(--ui-page-bg);
  color: var(--ui-text);
  font: 28rpx -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.container { padding: 26rpx 28rpx calc(42rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.card { background: var(--ui-card); border: 1rpx solid rgba(229, 234, 246, .9); border-radius: 30rpx; box-shadow: 0 12rpx 32rpx rgba(75, 91, 145, .08); }
.page-title { font-size: 42rpx; font-weight: 700; line-height: 1.25; }
.section-title { font-size: 34rpx; font-weight: 700; line-height: 1.35; }
.muted { color: var(--ui-muted); line-height: 1.55; }
.primary-button { min-height: 92rpx; margin: 0; border: 0; border-radius: 24rpx; background: linear-gradient(135deg, var(--ui-primary-deep), var(--ui-primary)); color: #fff; font-weight: 700; box-shadow: 0 12rpx 22rpx rgba(79, 82, 242, .26); }
.primary-button::after, .secondary-button::after { border: 0; }
.secondary-button { min-height: 80rpx; margin: 0; border: 0; border-radius: 20rpx; background: #eef1ff; color: var(--ui-primary); font-weight: 600; }
.input { min-height: 76rpx; background: #fff; border: 2rpx solid var(--ui-line); border-radius: 18rpx; padding: 0 22rpx; box-sizing: border-box; }
.tag { display: inline-flex; align-items: center; border-radius: 999rpx; padding: 8rpx 16rpx; font-size: 23rpx; font-weight: 600; }
.safe-bottom { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
