.settings-page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.settings-card{margin-bottom:20rpx}.row,.menu-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:22rpx 0;border-bottom:1rpx solid #eef1f6;color:#44516a;font-size:26rpx}.row:last-child,.menu-row:last-child{border-bottom:0}.row-value{max-width:64%;text-align:right;line-height:1.5}.menu-row{color:#26334d}.menu-row text:last-child{color:#758198}.model-card{overflow:hidden}.model-note{margin:8rpx 0 18rpx;color:#758198;font-size:24rpx;line-height:1.65}.model-loading{padding:24rpx 0;color:#758198;font-size:25rpx}.model-option{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:24rpx 22rpx;margin-top:14rpx;border:2rpx solid #e7ebf2;border-radius:18rpx;background:#fff}.model-option-active{border-color:#365fd9;background:#f4f7ff}.model-option-disabled{opacity:.55}.model-option-main{min-width:0;flex:1}.model-name-row{display:flex;align-items:center;gap:14rpx;flex-wrap:wrap}.model-name{color:#26334d;font-size:28rpx;font-weight:600}.model-current,.model-ready,.model-unready{padding:4rpx 12rpx;border-radius:999rpx;font-size:20rpx}.model-current{color:#3157c8;background:#e7edff}.model-ready{color:#26734d;background:#e5f6ed}.model-unready{color:#8b5b16;background:#fff1d5}.model-description{display:block;margin-top:8rpx;color:#758198;font-size:23rpx;line-height:1.5}.model-radio{color:#365fd9;font-size:34rpx}.model-warning{margin-top:16rpx;color:#a35a00;font-size:23rpx;line-height:1.55}
.model-runtime{margin-top:12rpx;color:#8a94a8;font-size:20rpx;line-height:1.45;word-break:break-all}
