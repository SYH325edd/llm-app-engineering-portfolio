.legal-page{min-height:100vh;padding:28rpx 28rpx calc(50rpx + env(safe-area-inset-bottom));background:#f5f7fc;color:#26334d;box-sizing:border-box}.legal-head{padding:30rpx;border-radius:26rpx;background:linear-gradient(135deg,#eef1ff,#e5eaff)}.legal-title{font-size:38rpx;font-weight:700}.legal-meta{margin-top:12rpx;color:#68758b;font-size:24rpx}.legal-card{margin-top:20rpx;padding:30rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 26rpx rgba(59,77,125,.06)}.legal-card-title{font-size:30rpx;font-weight:700}.legal-card-text{margin-top:16rpx;color:#5f6d84;font-size:26rpx;line-height:1.8}.legal-list{margin-top:12rpx}.legal-list view{position:relative;margin-top:10rpx;padding-left:28rpx;color:#5f6d84;font-size:26rpx;line-height:1.7}.legal-list view::before{position:absolute;left:2rpx;content:'•';color:#526df5}.contact-button{width:100%;margin-top:22rpx;border:0;border-radius:19rpx;background:#eef1ff;color:#526df5;font-size:27rpx}.contact-button::after{border:0}
