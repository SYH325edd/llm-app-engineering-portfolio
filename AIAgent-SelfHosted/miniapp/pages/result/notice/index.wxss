.notice-page{min-height:100vh;display:flex;align-items:center;box-sizing:border-box}.notice-card{width:100%;padding:58rpx 38rpx;text-align:center;box-sizing:border-box}.notice-icon{width:110rpx;height:110rpx;margin:0 auto 28rpx;border-radius:50%;background:#eef1ff;color:var(--ui-primary);font-size:60rpx;line-height:110rpx;font-weight:700}.notice-description{margin:22rpx 0 34rpx}.notice-meta{margin:0 0 36rpx;padding:8rpx 24rpx;border-radius:22rpx;background:#f7f8fd;text-align:left}.notice-meta view{display:flex;align-items:center;justify-content:space-between;min-height:72rpx;border-bottom:1rpx solid var(--ui-line)}.notice-meta view:last-child{border-bottom:0}.notice-meta text{color:var(--ui-muted)}.notice-meta strong{font-weight:700}.notice-card .secondary-button{margin-top:18rpx}
