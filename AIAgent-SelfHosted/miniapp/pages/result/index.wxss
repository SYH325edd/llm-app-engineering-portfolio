.state-card{padding:40rpx;text-align:center}.selector-card,.image-card,.result-card{margin-bottom:20rpx;padding:26rpx}.selector-label{margin-bottom:18rpx;font-size:30rpx;font-weight:700}.panel-icon{margin-right:12rpx;color:#6572f6}.picker{display:flex;align-items:center;gap:16rpx;min-height:84rpx;padding:0 20rpx;border:2rpx solid #dbe0ff;border-radius:20rpx;color:#222b3c;font-size:26rpx;box-sizing:border-box}.picker>view{flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.picker>text:first-child{color:#6572f6}.picker-arrow{color:#808da3;font-size:34rpx}.switch-tip,.inline-error{margin-top:12rpx;font-size:24rpx}.inline-error{color:#f14e55}.image-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.image-header>text{color:#526df5;font-size:24rpx}.image-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.image-item image,.image-failed{width:100%;height:150rpx;border-radius:15rpx;background:#f1f4f8}.image-item text{display:block;margin-top:7rpx;color:#59657c;text-align:center;font-size:23rpx}.image-failed{display:flex;align-items:center;justify-content:center;padding:12rpx;color:#7c879c;text-align:center;font-size:22rpx;box-sizing:border-box}.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin:20rpx 0}.summary-item{min-height:114rpx;padding:16rpx 18rpx;border:1rpx solid;border-radius:20rpx;box-sizing:border-box}.summary-item text{display:block;color:#677287;font-size:23rpx}.summary-item strong{display:block;margin-top:6rpx;font-size:44rpx}.summary-item.total{background:#f4f6ff;border-color:#d9deff;color:#526df5}.summary-item.correct{background:#f1fbf6;border-color:#d8f3e5;color:#20b96d}.summary-item.wrong{background:#fff4f4;border-color:#ffdcdc;color:#ff5b61}.summary-item.careless{background:#fff9ef;border-color:#ffe8bf;color:#ff9d14}.question{margin-top:14rpx;padding:22rpx;border:1rpx solid #e6eaf4;border-radius:23rpx}.question-head{display:flex;align-items:center;justify-content:space-between}.judge-dot{display:inline-flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;margin-right:13rpx;border-radius:50%;color:#fff;font-weight:700}.judge-dot.ok{background:#20b96d}.judge-dot.bad{background:#ff5b61}.question-name{font-size:28rpx;font-weight:700}.ok-text{color:#20b96d}.bad-text{color:#ff5b61}.score{padding:7rpx 13rpx;border-radius:999rpx;background:#f0f2ff;color:#526df5;font-size:22rpx}.answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx 20rpx;margin-top:18rpx;color:#334057;font-size:23rpx}.answer-grid>view{display:flex;gap:10rpx;min-width:0}.answer-grid text{flex:none;color:#7c879c}.answer-grid view{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.reason{margin-top:14rpx;padding-top:14rpx;border-top:1rpx solid #edf0f5;color:#657187;font-size:23rpx;line-height:1.5}.detail-button{width:100%;margin-top:22rpx}
.result-labels{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}.answer-label,.careless-label{padding:7rpx 13rpx;border-radius:999rpx;font-size:22rpx;font-weight:650}.answer-label.correct{background:#eafaf2;color:#20b96d}.answer-label.wrong{background:#fff0f1;color:#ff5b61}.answer-label.uncertain{background:#fff7e7;color:#f09a14}.answer-label.process-warning{background:#fff7e7;color:#b06a00}.careless-label.careless{background:#fff4e5;color:#ef920b}.careless-label.not_careless{background:#eef4ff;color:#526df5}.careless-label.uncertain{background:#f3f4f6;color:#718096}
.manager-search{display:flex;align-items:center;height:78rpx;margin:0 0 20rpx;padding:0 22rpx;background:#fff;border:1rpx solid var(--ui-line);border-radius:20rpx;box-sizing:border-box}.manager-search text{margin-right:12rpx;color:var(--ui-muted)}.manager-search input{flex:1;font-size:27rpx}.manager-state{padding:58rpx 28rpx;text-align:center}.manager-state .secondary-button{margin-top:24rpx}.manager-card{margin-bottom:18rpx;padding:28rpx}.manager-card:active{background:#f8f9ff}.manager-card-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.manager-name{min-width:0;font-size:32rpx;font-weight:700;word-break:break-all}.manager-arrow{color:#9ca6b8;font-size:40rpx}.manager-stats{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.manager-stat{padding:9rpx 13rpx;border-radius:14rpx;background:#f4f6ff;color:#526df5;font-size:23rpx}.manager-stat.success{background:#edf9f3;color:#20b96d}

.ai-notice{margin-bottom:20rpx;padding:18rpx 22rpx;border:1rpx solid #dfe4ff;border-radius:18rpx;background:#f5f7ff;color:#65718a;font-size:23rpx;line-height:1.6}
.student-result-hidden{margin-top:42rpx;padding:56rpx 38rpx;text-align:center}.student-result-hidden-icon{width:104rpx;height:104rpx;margin:0 auto 28rpx;border-radius:50%;background:#eef1ff;color:var(--ui-primary);font-size:56rpx;line-height:104rpx;font-weight:700}.student-result-hidden .muted{margin:22rpx 0 36rpx}.student-result-hidden .secondary-button{margin-top:18rpx}
