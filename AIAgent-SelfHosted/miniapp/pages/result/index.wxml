<view class="container result-page">
  <view wx:if="{{false}}" class="manager-page">
    <view class="manager-search"><text>搜索</text><input placeholder="搜索地区" bindinput="managerSearch" value="{{managerKeyword}}" /></view>
    <view wx:if="{{managerLoading}}" class="card manager-state muted">正在加载地区</view>
    <view wx:elif="{{managerError}}" class="card manager-state"><view>{{managerError}}</view><button class="secondary-button" bindtap="loadManagerClasses">重新加载</button></view>
    <view wx:elif="{{!managerVisible.length}}" class="card manager-state muted">{{managerKeyword ? '未找到匹配地区' : '暂无已录入学生的地区'}}</view>
    <view wx:else><view wx:for="{{managerVisible}}" wx:key="rosterId" class="card manager-card" data-roster-id="{{item.rosterId}}" bindtap="openManagerClass"><view class="manager-card-head"><view class="manager-name">{{item.name}}</view><text class="manager-stat">{{item.region}}</text><text class="manager-arrow">></text></view><view wx:if="{{item.studentNumber}}" class="manager-number">学号：{{item.studentNumber}}</view><view class="manager-stats"><text class="manager-stat success">已完成 {{item.completedCount || 0}}</text></view></view></view>
  </view>
  <view wx:elif="{{isManager}}" class="manager-page">
    <view class="manager-search"><text>搜索</text><input placeholder="搜索学生姓名或学号" bindinput="managerSearch" value="{{managerKeyword}}" /></view>
    <view wx:if="{{managerLoading}}" class="card manager-state muted">正在加载学生</view>
    <view wx:elif="{{managerError}}" class="card manager-state"><view>{{managerError}}</view><button class="secondary-button" bindtap="loadManagerClasses">重新加载</button></view>
    <view wx:elif="{{!managerVisible.length}}" class="card manager-state muted">{{managerKeyword ? '未找到匹配学生' : '暂无可管理学生'}}</view>
    <view wx:else><view wx:for="{{managerVisible}}" wx:key="rosterId" class="card manager-card" data-roster-id="{{item.rosterId}}" bindtap="openManagerClass"><view class="manager-card-head"><view class="manager-name">{{item.name}}</view><text class="manager-stat">{{item.region}}</text><text class="manager-arrow">></text></view><view wx:if="{{item.studentNumber}}" class="manager-number">学号：{{item.studentNumber}}</view><view class="manager-stats"><text class="manager-stat success">已完成 {{item.completedCount || 0}}</text></view></view></view>
  </view>
  <view wx:elif="{{studentResultHidden}}" class="card student-result-hidden">
    <view class="student-result-hidden-icon">✓</view>
    <view class="page-title">批改结果由老师查看</view>
    <view class="muted">作业已提交，详细批改结果将由老师查看并进行讲解。</view>
    <button class="primary-button" bindtap="goHome">返回首页</button>
    <button class="secondary-button" bindtap="continueUpload">继续上传</button>
  </view>
  <block wx:else>
  <view class="ai-notice">本结果由人工智能辅助生成，仅供学习参考，最终结果可由教师复核。</view>
  <view wx:if="{{loading}}" class="card state-card muted">正在加载批改记录</view>
  <view wx:elif="{{errorMessage && !selectedTask}}" class="card state-card"><view class="page-title">结果加载失败</view><view class="muted">{{errorMessage}}</view><button class="secondary-button" bindtap="retryLoad">重新加载</button></view>
  <view wx:elif="{{empty}}" class="card state-card muted">暂无批改结果</view>
  <view wx:else>
    <view class="card selector-card"><view class="selector-label"><text class="panel-icon">▣</text>选择批改记录</view><picker mode="selector" range="{{completedTasks}}" range-key="title" value="{{selectedTaskIndex}}" bindchange="chooseTask"><view class="picker"><text>▣</text><view>{{selectedTask.title || '选择批改记录'}}（{{selectedTask.imageCount || 0}}张图片 · {{selectedTask.questionCount || 0}}道题）</view><text class="picker-arrow">⌄</text></view></picker><view wx:if="{{switching}}" class="muted switch-tip">正在切换记录</view><view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view></view>
    <view wx:if="{{homeworkImages.length}}" class="card image-card"><view class="image-header"><view class="section-title"><text class="panel-icon">▣</text>上传的作业图片</view><text>共 {{homeworkImages.length}} 张</text></view><view class="image-grid"><view wx:for="{{homeworkImages}}" wx:key="fileId" class="image-item" data-index="{{index}}" data-type="homework" data-url="{{item.tempUrl}}" bindtap="previewImage"><image wx:if="{{!item.loadFailed}}" src="{{item.tempUrl}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}" data-type="homework"/><view wx:else class="image-failed">该图片暂时无法加载</view><text>第 {{item.index}} 张</text></view></view></view>
    <view wx:if="{{answerImages.length}}" class="card image-card"><view class="image-header"><view class="section-title"><text class="panel-icon">▣</text>上传的标准答案图片</view><text>共 {{answerImages.length}} 张</text></view><view class="image-grid"><view wx:for="{{answerImages}}" wx:key="fileId" class="image-item" data-index="{{index}}" data-type="answer" data-url="{{item.tempUrl}}" bindtap="previewImage"><image wx:if="{{!item.loadFailed}}" src="{{item.tempUrl}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}" data-type="answer"/><view wx:else class="image-failed">该图片暂时无法加载</view><text>第 {{item.index}} 张</text></view></view></view>
    <view class="card result-card"><view class="section-title"><text class="panel-icon">▥</text>批改结果</view><view class="summary-grid"><view class="summary-item total"><text>总题数</text><text class="summary-num">{{summary.totalCount || 0}}</text></view><view class="summary-item correct"><text>正确题数</text><text class="summary-num">{{summary.correctCount || 0}}</text></view><view class="summary-item wrong"><text>错误题数</text><text class="summary-num">{{summary.wrongCount || 0}}</text></view><view class="summary-item careless"><text>{{displayMode === 'reading' ? '填写不完整' : displayMode === 'hard' ? '未作答/不可读' : displayMode === 'calculation' ? '存在马虎题数' : '疑似马虎题数'}}</text><text class="summary-num">{{displayMode === 'reading' || displayMode === 'hard' ? (summary.incompleteCount || 0) : (summary.carelessCount || 0)}}</text></view></view><view wx:for="{{questions}}" wx:key="sourceKey" class="question"><block wx:if="{{displayMode === 'reading'}}"><view class="question-head"><view><text class="judge-dot {{item.threeGridStatus === 'CORRECT' ? 'ok' : 'bad'}}">{{item.threeGridStatus === 'CORRECT' ? '✓' : '×'}}</text><text class="question-name">第{{item.number}}题</text></view></view><view class="result-labels"><view class="answer-label {{item.threeGridStatus === 'CORRECT' ? 'correct' : 'wrong'}}">三格结果：{{item.threeGridLabel}}</view></view><view class="answer-grid"><view><text>条件</text><view>{{item.studentConditionText || '未填写'}}（{{item.conditionCorrect === true ? '正确' : item.conditionCorrect === false ? '错误' : '无法判断'}}）</view></view><view><text>关系</text><view>{{item.studentRelationText || '未填写'}}（{{item.relationCorrect === true ? '正确' : item.relationCorrect === false ? '错误' : '无法判断'}}）</view></view><view><text>所求</text><view>{{item.studentAskText || '未填写'}}（{{item.askCorrect === true ? '正确' : item.askCorrect === false ? '错误' : '无法判断'}}）</view></view></view><view wx:if="{{item.errorReason}}" class="reason">错误原因：{{item.errorReason}}</view><view wx:if="{{item.correctionAdvice}}" class="reason">修改建议：{{item.correctionAdvice}}</view></block><block wx:elif="{{displayMode === 'hard'}}"><view class="question-head"><view><text class="judge-dot {{item.hardResultState === 'correct' ? 'ok' : 'bad'}}">{{item.hardResultState === 'correct' ? '✓' : item.hardResultState === 'process_wrong' ? '!' : '×'}}</text><text class="question-name">第{{item.number}}题</text></view></view><view class="result-labels"><view class="answer-label {{item.hardResultState === 'process_wrong' ? 'process-warning' : item.answerStatus}}">综合判断：{{item.answerLabel}}</view></view><view class="answer-grid"><view><text>题目</text><view>{{item.questionText}}</view></view><view><text>学生最终答案</text><view>{{item.studentAnswer || '未填写'}}</view></view><view><text>标准答案</text><view>{{item.correctAnswer}}</view></view></view><view wx:if="{{item.stepFeedbackCount > 0}}" class="reason">已生成 {{item.stepFeedbackCount}} 步解题过程与讲解分析，请点击下方查看完整结果。</view><view wx:if="{{item.overallFeedback}}" class="reason">整体反馈：{{item.overallFeedback}}</view><view wx:if="{{item.errorReason}}" class="reason">问题原因：{{item.errorReason}}</view></block><block wx:else><view class="question-head"><view><text class="judge-dot {{item.answerStatus === 'correct' ? 'ok' : 'bad'}}">{{item.answerStatus === 'correct' ? '✓' : '×'}}</text><text class="question-name">第{{item.number}}题</text></view></view><view class="result-labels"><view class="answer-label {{item.answerStatus}}">回答结果：{{item.answerLabel}}</view><view class="careless-label {{item.carelessStatus}}">马虎判断：{{item.carelessLabel}}</view></view><view class="answer-grid"><view><text>题目</text><view>{{item.questionText}}</view></view><view><text>学生答案</text><view>{{item.studentAnswer}}</view></view><view><text>正确答案</text><view>{{item.correctAnswer}}</view></view></view><view wx:if="{{item.judgementReason}}" class="reason">判定说明：{{item.judgementReason}}</view><view wx:if="{{item.errorReason}}" class="reason">错误原因：{{item.errorReason}}</view><view wx:if="{{item.carelessReason}}" class="reason">马虎说明：{{item.carelessReason}}</view></block></view><button class="secondary-button detail-button" bindtap="openDetail">查看完整结果</button><button wx:if="{{displayMode === 'hard'}}" class="secondary-button detail-button" bindtap="openHardProblemTraining">开始难题训练</button></view>
  </view>
  </block>
</view>
