.detail-page{min-height:100vh;padding:24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));background:#f5f7fc;box-sizing:border-box;color:#25324a}.detail-content{display:flex;flex-direction:column;gap:20rpx}.task-card,.detail-card,.questions-card,.state-card{background:#fff;border-radius:26rpx;box-shadow:0 10rpx 28rpx rgba(59,77,125,.07)}.task-card{padding:30rpx}.task-top{display:flex;align-items:center}.task-icon{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;margin-right:20rpx;border-radius:25rpx;background:linear-gradient(145deg,#7568f6,#a1a6ff);color:#fff;font-size:48rpx}.task-main{min-width:0;flex:1}.task-title{overflow:hidden;font-size:34rpx;font-weight:700;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.task-time{margin-top:8rpx;color:#73809a;font-size:23rpx}.task-meta{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:22rpx;color:#65718a;font-size:23rpx}.complete-tag{padding:6rpx 12rpx;border-radius:999rpx;background:#e9fbf2;color:#17ae6c}.detail-card{padding:26rpx}.card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx;color:#73809a;font-size:23rpx}.card-title{font-size:30rpx;font-weight:700;color:#25324a}.card-title text{margin-right:12rpx;color:#6974f7}.photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.photo-item{position:relative;overflow:hidden;border-radius:16rpx;background:#f2f4f8}.photo-item image,.image-failed{display:block;width:100%;height:172rpx;background:#eef1f5}.image-failed{display:flex;align-items:center;justify-content:center;padding:12rpx;color:#7c879b;text-align:center;font-size:22rpx;box-sizing:border-box}.photo-label{position:absolute;right:0;bottom:0;left:0;padding:8rpx 0;background:rgba(20,29,45,.63);color:#fff;text-align:center;font-size:21rpx}.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:20rpx}.stat{min-height:112rpx;padding:16rpx 20rpx;border-radius:16rpx;box-sizing:border-box}.stat text{display:block;font-size:23rpx}.stat strong{display:block;margin-top:7rpx;font-size:42rpx;line-height:1}.total{background:#f0f1ff;color:#5b61f1}.correct{background:#edfcf5;color:#16b76e}.wrong{background:#fff1f2;color:#fa5962}.careless{background:#fff6e9;color:#ff9415}.questions-card{padding:26rpx}.questions-card>.card-title{margin-bottom:18rpx}.question-card{margin-top:16rpx;padding:24rpx;border:1rpx solid #edf0f5;border-radius:20rpx;background:#fff}.question-card:first-of-type{margin-top:0}.question-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.question-title{flex:none;font-size:29rpx;font-weight:700}.question-tags{display:flex;justify-content:flex-end;flex-wrap:wrap;gap:8rpx}.answer-tag,.careless-tag{padding:6rpx 11rpx;border-radius:999rpx;font-size:21rpx;font-weight:650}.answer-tag.correct{background:#eafaf2;color:#17ae6c}.answer-tag.wrong{background:#fff0f1;color:#fa5962}.answer-tag.uncertain{background:#fff7e7;color:#ee9414}.careless-tag.careless{background:#fff5e8;color:#ef9212}.careless-tag.not_careless{background:#eef3ff;color:#526df5}.careless-tag.uncertain{background:#f1f3f6;color:#718096}.question-text{margin-top:20rpx;font-size:24rpx;line-height:1.6}.question-text>text,.answer-pair text,.reason-card text{display:block;margin-bottom:7rpx;color:#6c7890;font-size:22rpx}.answer-pair{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:18rpx}.answer-pair>view{min-height:112rpx;padding:16rpx;border-radius:13rpx;background:#f7f8fb;font-size:23rpx;line-height:1.45;box-sizing:border-box}.reason-card{margin-top:14rpx;padding:16rpx 18rpx;border-radius:13rpx;font-size:23rpx;line-height:1.5}.reason-card.error{background:#fff2f3;color:#bc4149}.reason-card.careless{background:#fff7ed;color:#c57013}.reason-card.judgement{background:#f4f6ff;color:#526078}.reason-card.error text{color:#fa5962}.reason-card.careless text{color:#ed9216}.state-card{margin:80rpx 0;padding:48rpx 32rpx;text-align:center}.state-title{font-size:32rpx;font-weight:700}.state-text{margin-top:14rpx;color:#728099}.retry-button{margin-top:28rpx;border:0;border-radius:18rpx;background:#526df5;color:#fff}.retry-button::after{border:0}.back-link{margin-top:22rpx;color:#526df5;font-size:26rpx}.loading-dot{width:52rpx;height:52rpx;margin:0 auto 20rpx;border:6rpx solid #e2e6ff;border-top-color:#526df5;border-radius:50%;box-sizing:border-box;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.empty-text{padding:40rpx 0;color:#7c879b;text-align:center}

.ai-notice{margin-bottom:20rpx;padding:18rpx 22rpx;border:1rpx solid #dfe4ff;border-radius:18rpx;background:#f5f7ff;color:#65718a;font-size:23rpx;line-height:1.6}
.status-pill{display:inline-flex;align-items:center;justify-content:center;padding:6rpx 18rpx;border-radius:999rpx;font-size:22rpx;font-weight:600;line-height:1.2;white-space:nowrap;box-sizing:border-box}.status-pill--correct{color:#22A06B;background:#EAF8F1;border:1rpx solid #B7E4CC}.status-pill--wrong{color:#E35B5B;background:#FDEEEE;border:1rpx solid #F3C4C4}.status-pill--warning{color:#B06A00;background:#FFF7E7;border:1rpx solid #F3D59B}
.question-text>view,.answer-pair>view>view,.reason-card>view{white-space:pre-wrap;word-break:break-word}

.step-analysis-card{background:#f7f8ff;color:#38435c}.step-feedback-card{margin-top:16rpx;padding:18rpx;border:1rpx solid #e4e8f6;border-radius:14rpx;background:#fff}.step-feedback-card:first-of-type{margin-top:8rpx}.step-feedback-title{margin-bottom:12rpx;color:#3d4d73;font-size:25rpx;font-weight:700}.step-feedback-row{margin-top:11rpx;line-height:1.6}.step-feedback-row>text{display:block;margin-bottom:4rpx;color:#6c7890;font-size:21rpx}.step-feedback-row>view{white-space:pre-wrap;word-break:break-word}.step-feedback-judgements{display:flex;flex-wrap:wrap;gap:8rpx 18rpx;margin-top:12rpx;padding:12rpx;border-radius:10rpx;background:#f5f7fb;color:#526078;font-size:21rpx}.step-feedback-row.advice{color:#8a5a12}.overall-feedback-card{background:#eef7ff;color:#3f5873}.overall-feedback-card>text{color:#3974a8}
