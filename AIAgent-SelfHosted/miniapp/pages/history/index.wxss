.filters{display:flex;padding:10rpx;border-radius:999rpx;background:#fff;box-shadow:0 10rpx 24rpx rgba(74,94,147,.07)}.filter-item{flex:1;padding:17rpx 0;border-radius:999rpx;color:#69758a;text-align:center;font-size:27rpx}.filter-item.active{background:linear-gradient(135deg,#5043f2,#526df5);color:#fff;font-weight:700;box-shadow:0 5rpx 12rpx rgba(81,91,240,.22)}.search-box{display:flex;align-items:center;height:76rpx;margin:22rpx 0;padding:0 22rpx;border-radius:19rpx;background:#fff;color:#9ca5b5;box-sizing:border-box}.search-box text{margin-right:12rpx;font-size:36rpx}.search-box input{flex:1;font-size:27rpx}.history-card{display:flex;align-items:flex-start;margin-bottom:20rpx;padding:28rpx 24rpx;box-sizing:border-box}.history-icon{display:flex;align-items:center;justify-content:center;flex:none;width:88rpx;height:88rpx;border-radius:27rpx;background:#fff0d7;color:#ff9d14;font-size:48rpx;font-weight:700}.history-icon.COMPLETED{background:#dff8eb;color:#20b96d}.history-icon.FAILED{background:#ffe5e6;color:#ff5b61}.history-main{min-width:0;flex:1;margin-left:22rpx}.history-title{overflow:hidden;font-size:32rpx;font-weight:700;white-space:nowrap;text-overflow:ellipsis}.history-time{margin-top:9rpx;color:#8590a4;font-size:25rpx}.status-tag{display:inline-block;margin-top:16rpx;padding:7rpx 15rpx;border-radius:999rpx;background:#fff4de;color:#ef920b;font-size:23rpx;font-weight:650}.status-tag.COMPLETED{background:#eafaf2;color:#20b96d}.status-tag.FAILED{background:#fff0f1;color:#ff5b61}.error-message{margin-top:14rpx;padding:13rpx 15rpx;border-radius:14rpx;background:#fff0f1;color:#f14e55;font-size:24rpx;line-height:1.4}.task-progress{display:flex;align-items:center;gap:14rpx;margin-top:16rpx;color:#7d879a;font-size:23rpx}.task-progress progress{flex:1}.chevron{align-self:center;color:#aab2c1;font-size:48rpx}.empty{padding:80rpx 20rpx;text-align:center}
.history-title{display:-webkit-box;overflow:hidden;line-height:1.35;white-space:normal;word-break:break-all;text-overflow:ellipsis;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.manager-search{display:flex;align-items:center;height:78rpx;margin:0 0 20rpx;padding:0 22rpx;background:#fff;border:1rpx solid var(--ui-line);border-radius:20rpx;box-sizing:border-box}.manager-search text{margin-right:12rpx;color:var(--ui-muted)}.manager-search input{flex:1;font-size:27rpx}.manager-state{padding:58rpx 28rpx;text-align:center}.manager-state .secondary-button{margin-top:24rpx}.manager-card{margin-bottom:18rpx;padding:28rpx}.manager-card:active{background:#f8f9ff}.manager-card-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.manager-name{min-width:0;font-size:32rpx;font-weight:700;word-break:break-all}.manager-arrow{color:#9ca6b8;font-size:40rpx}.manager-stats{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.manager-stat{padding:9rpx 13rpx;border-radius:14rpx;background:#f4f6ff;color:#526df5;font-size:23rpx}.manager-stat.success{background:#edf9f3;color:#20b96d}.manager-stat.danger{background:#fff0f1;color:#ff5b61}
