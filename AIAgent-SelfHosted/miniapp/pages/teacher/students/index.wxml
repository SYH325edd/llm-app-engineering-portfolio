<view class="container">
  <view class="row between">
    <view class="page-title">学生管理</view>
    <text bindtap="add">单独添加</text>
  </view>

  <view class="grid2 mt">
    <input class="input" data-k="className" value="{{className}}" bindinput="set" placeholder="地区筛选"/>
  </view>
  <view class="row between mt">
    <text>查看30天内已归档学生</text>
    <switch checked="{{archived}}" bindchange="toggleArchived"/>
  </view>
  <button class="secondary-button mt" loading="{{loading}}" bindtap="load">查询</button>

  <view wx:if="{{!archived && duplicateRequests.length}}">
    <view class="section-title mt">同名学生待确认</view>
    <view class="card" wx:for="{{duplicateRequests}}" wx:key="userId" wx:for-item="request">
      <view class="section-title">{{request.name}} · {{request.region || request.className}}</view>
      <view class="caption">请选择该微信账号对应的名单记录</view>
      <view class="list-item" wx:for="{{request.candidates}}" wx:key="_id" wx:for-item="candidate">
        <view>
          <view>{{candidate.name}} · {{candidate.region || candidate.className}}</view>
          <view class="caption" wx:if="{{candidate.extraSummary}}">{{candidate.extraSummary}}</view>
          <view class="caption" wx:if="{{candidate.alreadyBound}}">该名单已绑定其他微信</view>
        </view>
        <button
          size="mini"
          class="secondary-button"
          disabled="{{candidate.alreadyBound || bindingUserId}}"
          data-user-id="{{request.userId}}"
          data-roster-id="{{candidate._id}}"
          catchtap="bindDuplicate"
        >绑定</button>
      </view>
    </view>
  </view>

  <view class="section-title mt">{{archived ? '已归档学生' : '在读学生'}}</view>
  <view wx:if="{{checkinError}}" class="caption">{{checkinError}}</view>
  <view class="card" wx:for="{{items}}" wx:key="_id" data-id="{{item._id}}" bindtap="open">
    <view class="row between">
      <text>{{item.name}}</text>
      <text>{{item.region || item.className}}</text>
    </view>
    <view class="caption">今日进度：{{item.qualifiedQuestionCount}}/{{item.requiredQuestionCount}}　今日状态：{{item.todayStatusText}}</view>
    <view class="caption">练习天数：{{item.practiceDays}}天　成功打卡天数：{{item.successfulCheckinDays}}天</view>
    <view class="caption">答题准确率：{{item.accuracyRateText}}（{{item.correctQuestionCount}}/{{item.answeredQuestionCount}}）　打卡率：{{item.checkinRateText}}</view>
    <view class="caption" wx:if="{{item.archived}}">30天内可恢复</view>
  </view>
  <view class="empty-state" wx:if="{{!loading && !items.length}}"><view class="empty-title">暂无学生记录</view></view>
</view>
