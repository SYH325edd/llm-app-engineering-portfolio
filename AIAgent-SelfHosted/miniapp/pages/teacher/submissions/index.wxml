<view class="container"><view class="page-title">任务记录</view><input class="input" data-k="className" bindinput="set" value="{{className}}" placeholder="地区"/><input class="input" data-k="studentName" bindinput="set" value="{{studentName}}" placeholder="学生姓名"/><input class="input" data-k="status" bindinput="set" value="{{status}}" placeholder="状态"/><view class="row"><button loading="{{loading}}" bindtap="load">查询</button><button bindtap="clear">清空</button></view><view wx:if="{{!loading&&!items.length}}" class="empty-state">暂无任务</view><view class="card" wx:for="{{items}}" wx:key="_id" data-id="{{item._id}}" bindtap="open"><view>{{item.studentName}} · {{item.status}}</view><view>{{item.statusMessage}}</view><button wx:if="{{item.status === 'FAILED' && item.retryable !== false}}" data-task-id="{{item._id}}" loading="{{loading}}" catchtap="retry">重新处理</button></view></view>
