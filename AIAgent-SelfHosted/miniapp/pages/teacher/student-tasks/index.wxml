<view class="container manager-page">
  <view wx:if="{{loading}}" class="card manager-state muted">正在加载任务</view>
  <view wx:elif="{{errorMessage}}" class="card manager-state"><view>{{errorMessage}}</view><button class="secondary-button" bindtap="load">重新加载</button></view>
  <view wx:else>
    <view class="card date-filter"><text>按日期查找</text><picker mode="date" value="{{selectedDate}}" bindchange="chooseDate"><view class="date-picker">{{selectedDate || '请选择日期'}}</view></picker><button wx:if="{{selectedDate}}" class="secondary-button date-clear" bindtap="clearDate">清除日期</button></view>
    <view class="card student-summary"><view class="manager-name">{{student.name || '未命名学生'}}</view><view wx:if="{{student.studentNumber}}" class="manager-number">学号：{{student.studentNumber}}</view><view class="manager-stats"><text class="manager-stat">作业 {{student.taskCount || 0}}</text><text class="manager-stat success">已完成 {{student.completedCount || 0}}</text><text class="manager-stat danger">失败 {{student.failedCount || 0}}</text></view></view>
    <view wx:if="{{!visibleTasks.length}}" class="card manager-state muted">{{selectedDate ? '所选日期暂无作业记录' : (mode === 'result' ? '该学生暂无已完成批改结果' : '该学生暂无作业记录')}}</view>
    <view wx:for="{{visibleTasks}}" wx:key="taskId" class="card task-card" data-task-id="{{item.taskId}}" data-status="{{item.status}}" data-result-id="{{item.resultId}}" bindtap="open"><view class="task-main"><view class="task-title">{{item.displayTitle || item.title || '未命名作业'}}</view><view class="task-time">{{item.createdAt}}</view><text class="task-status {{item.status}}">{{item.status}}<block wx:if="{{item.progress}}"> · {{item.progress}}%</block></text><view wx:if="{{item.stage && item.status !== 'COMPLETED'}}" class="task-time">{{item.stage}}</view><view wx:if="{{item.totalQuestionCount !== null && item.totalQuestionCount !== undefined}}" class="task-time task-result-summary"><text>题目 {{item.totalQuestionCount}}</text><text>· 正确 {{item.correctCount}}</text><text wx:if="{{item.carelessCount > 0}}" class="task-careless-tag">马虎 {{item.carelessCount}}</text><text>· 错误 {{item.wrongCount}}</text><text>· 未完成 {{item.incompleteCount}}</text></view><view wx:elif="{{item.status === 'COMPLETED'}}" class="task-time">批改结果待就绪</view><view wx:if="{{item.status === 'FAILED' && (item.errorMessage || item.errorSuggestion)}}" class="task-error">{{item.errorMessage}} {{item.errorSuggestion}}</view></view><text class="task-chevron">›</text></view>
  </view>
</view>
