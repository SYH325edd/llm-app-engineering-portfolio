.manager-page{min-height:100vh}.manager-search{display:flex;align-items:center;height:78rpx;margin:18rpx 0 20rpx;padding:0 22rpx;background:#fff;border:1rpx solid var(--ui-line);border-radius:20rpx;box-sizing:border-box}.manager-search input{flex:1;font-size:27rpx}.manager-search text{margin-right:12rpx;color:var(--ui-muted)}.manager-state{padding:58rpx 28rpx;text-align:center}.manager-state .secondary-button{margin-top:24rpx}.manager-card{margin-bottom:18rpx;padding:28rpx}.manager-card:active{background:#f8f9ff}.manager-card-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.manager-name{min-width:0;font-size:32rpx;font-weight:700;word-break:break-all}.manager-arrow{flex:none;color:#9ca6b8;font-size:40rpx}.manager-number{margin-top:9rpx;color:var(--ui-muted);font-size:25rpx}.manager-stats{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.manager-stat{padding:9rpx 13rpx;border-radius:14rpx;background:#f4f6ff;color:#526df5;font-size:23rpx}.manager-stat.success{background:#edf9f3;color:#20b96d}.manager-stat.danger{background:#fff0f1;color:#ff5b61}.manager-stat.warning{background:#fff7e9;color:#ee9411}.student-summary{margin-bottom:20rpx;padding:28rpx}.student-summary .manager-stats{margin-bottom:0}.task-card{display:flex;align-items:flex-start;margin-bottom:18rpx;padding:26rpx}.task-main{min-width:0;flex:1}.task-title{font-size:31rpx;font-weight:700;line-height:1.35;word-break:break-all}.task-time{margin-top:10rpx;color:var(--ui-muted);font-size:24rpx}.task-status{display:inline-block;margin-top:14rpx;padding:7rpx 13rpx;border-radius:999rpx;background:#fff6e6;color:#ee9411;font-size:23rpx}.task-status.COMPLETED{background:#eafaf2;color:#20b96d}.task-status.FAILED{background:#fff0f1;color:#ff5b61}.task-status.NEED_CONFIRMATION{background:#eef1ff;color:#526df5}.task-error{margin-top:13rpx;color:#ef525a;font-size:23rpx;line-height:1.45}.task-chevron{align-self:center;margin-left:18rpx;color:#9ca6b8;font-size:40rpx}
