<view class="container manager-page">
  <view wx:if="{{loading}}" class="card state-card muted">加载中</view>
  <view wx:elif="{{error}}" class="card state-card"><view>{{error}}</view><button class="secondary-button" bindtap="onShow">重新加载</button></view>
  <view wx:else>
    <view wx:if="{{reviewMode}}" class="card"><view class="section-title">审核体验</view><view class="muted">当前为审核老师端</view><button class="secondary-button" bindtap="switchReviewRole">切换审核学生端</button><button class="secondary-button" bindtap="closeReviewSession">退出审核体验</button></view>
    <view wx:if="{{managerError}}" class="card state-card"><view>{{managerError}}</view><button class="secondary-button" bindtap="loadManagerClasses">重新加载</button></view>
    <view class="manager-profile-card"><view class="profile-copy"><view class="profile-name">{{user.name || '管理员'}} 管理中心</view><view class="role-badge">{{user.role === 'super_admin' ? '超级管理员' : '教师管理员'}}</view></view></view>
    <view class="card dashboard-card"><view class="dashboard-head"><view class="section-title">学生数据总览</view></view><view wx:if="{{managerLoading && !classSummary}}" class="inline-state muted">正在加载学生数据</view><view wx:else class="manager-stat-grid"><view class="manager-stat student"><view><text>学生</text><strong>{{classSummary.studentCount || 0}}</strong></view></view><view class="manager-stat task"><view><text>任务</text><strong>{{classSummary.taskCount || 0}}</strong></view></view><view class="manager-stat processing"><view><text>处理中</text><strong>{{classSummary.processingCount || 0}}</strong></view></view><view class="manager-stat completed"><view><text>已完成</text><strong>{{classSummary.completedCount || 0}}</strong></view></view><view wx:if="{{features.wrongQuestions}}" class="manager-stat wrong"><view><text>错题</text><strong>{{classSummary.wrongCount || 0}}</strong></view></view><view class="manager-stat failed"><view><text>失败</text><strong>{{classSummary.failedCount || 0}}</strong></view></view></view></view>
    <view class="card feature-list"><view class="feature-row" data-url="/pages/teacher/students/index" bindtap="go"><text>学生与地区管理</text><text class="feature-arrow">></text></view><view class="feature-row" data-url="/pages/teacher/submissions/index" bindtap="go"><text>任务管理</text><text class="feature-arrow">></text></view><view class="feature-row" data-url="/pages/teacher/import/index" bindtap="go"><text>批量导入学生</text><text class="feature-arrow">></text></view><view wx:if="{{features.dataExport}}" class="feature-row" data-url="/pages/teacher/export/index" bindtap="go"><text>导出数据</text><text class="feature-arrow">></text></view><view wx:if="{{user.role === 'super_admin'}}" class="feature-row" data-url="/pages/teacher/teachers/index" bindtap="go"><text>老师与权限</text><text class="feature-arrow">></text></view><view wx:if="{{user.role === 'super_admin'}}" class="feature-row" bindtap="settings"><text>系统设置</text><text class="feature-arrow">></text></view><view wx:if="{{user.role === 'super_admin'}}" class="feature-row" data-url="/pages/teacher/audit/index" bindtap="go"><text>系统日志</text><text class="feature-arrow">></text></view></view>
    <view wx:if="{{features.wrongQuestions}}" class="card wrong-list-card"><view class="dashboard-head"><view class="section-title">学生错题</view></view><view wx:if="{{managerLoading}}" class="inline-state muted">正在刷新</view><view wx:elif="{{!wrongQuestions.length}}" class="inline-state muted">暂无未掌握错题</view><view wx:else><view wx:for="{{wrongQuestions}}" wx:key="taskId" class="wrong-row" data-task-id="{{item.taskId}}" bindtap="openWrong"><view class="wrong-main"><view class="wrong-title">{{item.studentName || '未命名学生'}} · {{item.sourceKey || item.questionText || '题目'}}</view><view class="wrong-reason">{{item.errorReason || '暂无错误原因'}}</view></view><text class="feature-arrow">></text></view></view></view>
  </view>
</view>
