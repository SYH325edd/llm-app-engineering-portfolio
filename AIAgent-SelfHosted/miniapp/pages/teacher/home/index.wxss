.manager-page{min-height:100vh;background:linear-gradient(150deg,#f5f7ff,#edf2ff)}.state-card{padding:40rpx;text-align:center}.state-card .secondary-button{margin-top:22rpx}.manager-profile-card{position:relative;display:flex;min-height:210rpx;margin-bottom:24rpx;padding:28rpx;overflow:hidden;border:1rpx solid #e0e5fb;border-radius:30rpx;background:linear-gradient(135deg,#fff 0%,#f1f3ff 100%);box-shadow:0 12rpx 32rpx rgba(75,91,145,.08);box-sizing:border-box}.profile-copy{position:relative;z-index:1;min-width:0;flex:1}.profile-name{font-size:39rpx;font-weight:700;line-height:1.3}.role-badge{display:inline-block;margin-top:12rpx;padding:7rpx 14rpx;border-radius:12rpx;background:#eef0ff;color:#5c68f6;font-size:24rpx}.profile-label{margin-top:22rpx;color:#68758c;font-size:24rpx}.profile-summary{margin-top:8rpx;color:#66738a;font-size:22rpx;line-height:1.65}.blue{color:#526df5}.orange{color:#f28c16}.green{color:#18b46a}.red{color:#f4515e}.profile-illustration{position:relative;flex:none;width:166rpx}.illustration-back,.illustration-card{position:absolute;border-radius:16rpx;background:linear-gradient(145deg,#aebaff,#6561ed);box-shadow:0 12rpx 20rpx rgba(78,86,214,.22)}.illustration-back{top:20rpx;right:26rpx;width:92rpx;height:106rpx;transform:rotate(8deg)}.illustration-card{top:36rpx;right:0;width:112rpx;height:126rpx;padding:18rpx;background:linear-gradient(145deg,#fff,#dce2ff);box-sizing:border-box}.illustration-card view:not(.illustration-avatar){height:8rpx;margin:9rpx 0 0 40rpx;border-radius:999rpx;background:#b4bcf7}.illustration-avatar{float:left;width:31rpx;height:31rpx;border-radius:50%;background:#7682f7;color:#fff;text-align:center;line-height:31rpx}.illustration-gear{position:absolute;right:-5rpx;bottom:12rpx;color:#6874f4;font-size:48rpx;text-shadow:0 6rpx 12rpx #d6dbff}.dashboard-card,.wrong-list-card{margin-bottom:24rpx;padding:28rpx}.dashboard-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}.class-picker{max-width:265rpx;padding:12rpx 17rpx;border:1rpx solid #dce3f4;border-radius:20rpx;background:#fff;color:#526df5;font-size:24rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.manager-stat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx}.manager-stat{display:flex;align-items:center;min-height:118rpx;padding:13rpx 11rpx;border-radius:20rpx;background:linear-gradient(135deg,#f8f9ff,#eef0ff);color:#526df5}.manager-stat-icon{display:flex;align-items:center;justify-content:center;flex:none;width:48rpx;height:48rpx;margin-right:10rpx;border-radius:13rpx;background:#dfe3ff;color:#5967f4;font-size:28rpx;font-weight:700}.manager-stat text,.manager-stat strong{display:block}.manager-stat text{color:#46526b;font-size:22rpx}.manager-stat strong{margin-top:3rpx;color:#1f2b44;font-size:41rpx;line-height:1}.manager-stat.processing{background:linear-gradient(135deg,#fff,#fff5e4)}.manager-stat.processing .manager-stat-icon{background:#fff0d1;color:#f29a19}.manager-stat.completed{background:linear-gradient(135deg,#fff,#edf9f3)}.manager-stat.completed .manager-stat-icon{background:#d8f5e5;color:#18b46a}.manager-stat.wrong{background:linear-gradient(135deg,#fff,#fff3ec)}.manager-stat.wrong .manager-stat-icon{background:#ffe1d5;color:#f05e41}.manager-stat.failed{background:linear-gradient(135deg,#fff,#fff1f3)}.manager-stat.failed .manager-stat-icon{background:#ffe0e4;color:#f4515e}.feature-list{margin-bottom:24rpx;overflow:hidden}.feature-row{display:flex;align-items:center;min-height:86rpx;padding:0 22rpx;border-bottom:1rpx solid #edf0f6;color:#24314a;font-size:29rpx}.feature-row:last-child{border-bottom:0}.feature-icon{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;margin-right:20rpx;border-radius:14rpx;background:linear-gradient(135deg,#eef0ff,#dcdfff);color:#5e69f5;font-size:29rpx}.feature-arrow{margin-left:auto;color:#98a3b8;font-size:42rpx;font-weight:300}.wrong-row{display:flex;align-items:center;min-height:98rpx;padding:13rpx 0;border-bottom:1rpx solid #edf0f6}.wrong-row:last-child{border-bottom:0}.wrong-avatar{display:flex;align-items:center;justify-content:center;flex:none;width:55rpx;height:55rpx;margin-right:14rpx;border-radius:50%;background:linear-gradient(135deg,#f7d6ce,#d8e5ff);color:#5967f4;font-size:31rpx}.wrong-main{min-width:0;flex:1}.wrong-title{overflow:hidden;color:#27334a;font-size:25rpx;font-weight:650;white-space:nowrap;text-overflow:ellipsis}.wrong-reason{margin-top:6rpx;overflow:hidden;color:#8390a4;font-size:21rpx;white-space:nowrap;text-overflow:ellipsis}.wrong-side{flex:none;width:132rpx;margin-left:10rpx;text-align:right}.wrong-point{display:inline-block;max-width:128rpx;overflow:hidden;padding:5rpx 10rpx;border-radius:999rpx;background:#eef0ff;color:#6170ed;font-size:19rpx;white-space:nowrap;text-overflow:ellipsis}.wrong-time{margin-top:7rpx;color:#8995a9;font-size:20rpx}.inline-state{padding:34rpx 16rpx;text-align:center}
