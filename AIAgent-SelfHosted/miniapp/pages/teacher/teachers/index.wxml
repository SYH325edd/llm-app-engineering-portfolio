<view class="container">
  <view class="page-title">教师身份审核</view>
  <view class="section-title mt">待审核申请</view>
  <view class="card" wx:for="{{applications}}" wx:key="userId" wx:for-item="application">
    <view class="section-title">{{application.name}}</view>
    <view class="caption">任教地区：{{application.requestedScopes[0].region || application.requestedScopes[0].className}}</view>
    <view class="caption">提交时间：{{application.submittedAt}}</view>
    <view class="caption">当前状态：{{application.status}}</view>
    <textarea class="textarea mt" placeholder="拒绝原因（拒绝时必填）" value="{{application.rejectReason}}" data-index="{{index}}" bindinput="setRejectReason"/>
    <view class="two-buttons mt"><button class="primary-button" data-index="{{index}}" bindtap="approve">审核通过</button><button class="ghost-button" data-index="{{index}}" bindtap="reject">审核拒绝</button></view>
  </view>
  <view class="empty-state" wx:if="{{!loading && !applications.length}}"><view class="empty-title">暂无待审核教师申请</view></view>
  <view class="section-title mt">已审核通过的教师</view>
  <view class="card" wx:for="{{teachers}}" wx:key="userId" wx:for-item="teacher">
    <view class="row between"><text>{{teacher.name || teacher.userId}}</text><text>教师 · ACTIVE</text></view>
    <button class="secondary-button mt" data-index="{{index}}" bindtap="promote">提升为超级管理员</button>
  </view>
</view>
