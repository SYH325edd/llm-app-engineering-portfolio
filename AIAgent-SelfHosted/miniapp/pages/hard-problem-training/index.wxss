.page{min-height:100vh;background:#f5f7fc;padding:24rpx;box-sizing:border-box;color:#202431}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 8rpx 28rpx rgba(31,43,86,.06)}.title{font-size:40rpx;font-weight:700;margin-bottom:14rpx}.section-title{font-size:32rpx;font-weight:700;margin-bottom:16rpx}.level{color:#526df5;font-weight:600;margin-bottom:16rpx}.brief,.desc,.meta{font-size:26rpx;line-height:1.7;color:#667085}.purpose,.variant-question{font-size:30rpx;line-height:1.65;font-weight:600;margin:16rpx 0}.feedback{background:#f0f4ff;padding:18rpx;border-radius:14rpx;color:#4054b2;margin:14rpx 0;line-height:1.6}.hint{background:#fff8e7;padding:18rpx;border-radius:14rpx;color:#8a6514;margin:14rpx 0;line-height:1.6}.input{width:100%;min-height:180rpx;background:#f8f9fc;border:1px solid #e5e7ef;border-radius:16rpx;padding:20rpx;box-sizing:border-box;margin:16rpx 0}.input.tall{min-height:300rpx}.primary{background:#526df5!important;color:#fff!important;border-radius:16rpx;margin-top:16rpx}.variant-tabs{display:flex;gap:12rpx;flex-wrap:wrap}.variant-tab{padding:12rpx 18rpx;background:#eef1f7;border-radius:999rpx;font-size:24rpx}.variant-tab.active{background:#526df5;color:#fff}.variant-tab.done{border:1px solid #3aa76d}.success{border:1px solid #bfe7cf}.error{background:#fff0f0;color:#b42318;padding:18rpx;border-radius:14rpx;margin-bottom:20rpx}
