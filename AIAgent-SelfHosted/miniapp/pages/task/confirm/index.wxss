.confirm-page{min-height:100vh;background:linear-gradient(150deg,#f4f7ff,#eef3ff)}.confirm-page .page-title{margin-top:12rpx;color:#1d2942;font-size:43rpx}.confirm-intro{margin:13rpx 2rpx 22rpx;color:#6e7b91;font-size:25rpx;line-height:1.55}.confirmation-card,.answer-card{margin-bottom:22rpx;padding:26rpx}.confirmation-item{padding:20rpx 0;border-bottom:1rpx solid #edf0f6}.confirmation-item:first-child{padding-top:0}.confirmation-item:last-child{padding-bottom:0;border-bottom:0}.confirmation-item-head{display:flex;align-items:center;gap:12rpx}.confirmation-type{padding:6rpx 12rpx;border-radius:999rpx;background:#fff1dc;color:#e98a17;font-size:22rpx}.confirmation-key{color:#27344d;font-size:28rpx;font-weight:700;word-break:break-all}.confirmation-label{margin-top:16rpx;color:#768298;font-size:22rpx}.confirmation-value{margin-top:5rpx;color:#334059;font-size:25rpx;line-height:1.55;word-break:break-all}.confirmation-fallback{padding:16rpx 0;color:#46536c;font-size:27rpx;line-height:1.65}.answer-textarea{width:100%;min-height:180rpx;margin-top:18rpx;padding:18rpx;border:1rpx solid #e1e6f3;border-radius:18rpx;background:#f9faff;color:#26334d;font-size:27rpx;line-height:1.5;box-sizing:border-box}.answer-image-head{display:flex;justify-content:space-between;margin-top:24rpx;color:#2b3850;font-size:27rpx}.answer-image-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:16rpx}.answer-image-item{position:relative;width:154rpx;height:154rpx;overflow:hidden;border-radius:16rpx;background:#edf0f7}.answer-image-item image{width:100%;height:100%}.image-unavailable{display:flex;align-items:center;justify-content:center;height:100%;padding:12rpx;color:#79859a;font-size:22rpx;text-align:center;box-sizing:border-box}.image-delete{position:absolute;right:8rpx;bottom:8rpx;padding:5rpx 10rpx;border-radius:999rpx;background:rgba(32,40,60,.72);color:#fff;font-size:21rpx}.add-answer-image{margin-top:20rpx}.fixed-action{position:fixed;right:0;bottom:0;left:0;padding:18rpx 28rpx calc(18rpx 