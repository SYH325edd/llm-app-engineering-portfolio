.create-page{min-height:100vh}.page-heading{margin:28rpx 24rpx 36rpx}.page-title{color:#26324b;font-size:36rpx;font-weight:700}.page-description{margin-top:12rpx;color:#7B8497;font-size:24rpx}.mode-card{box-sizing:border-box;display:flex;align-items:center;min-height:164rpx;margin:0 24rpx 20rpx;padding:28rpx;background:#fff;border:1rpx solid #edf0f5;border-radius:24rpx;box-shadow:0 4rpx 12rpx rgba(38,50,75,.04);transition:transform .12s ease,background-color .12s ease}.mode-card--pressed{background:#f3f8ff;transform:scale(.98)}.mode-icon{display:flex;align-items:center;justify-content:center;flex:none;width:64rpx;height:64rpx;margin-right:20rpx;border-radius:18rpx;font-size:28rpx;font-weight:600}.mode-icon--hard{color:#5769d9;background:#eef0ff}.mode-icon--reading{color:#d98227;background:#fff3e7}.mode-icon--calculation{color:#36a26b;background:#e9f8f0}.mode-content{flex:1;min-width:0}.mode-title{color:#26324b;font-size:32rpx;font-weight:600}.mode-description{margin-top:10rpx;color:#7B8497;font-size:24rpx;line-height:1.5}.mode-arrow{margin-left:16rpx;color:#b7becb;font-size:40rpx;font-weight:300;line-height:1}
