<view class="container processing">
  <view class="card progress-card">
    <view class="task-name">{{task.displayTitle || task.title || '批改任务'}}</view>
    <view class="progress-row"><view class="progress-label">批改进度</view><view class="progress-number">{{displayProgress}}%</view></view>
    <progress class="progress-bar" percent="{{displayProgress}}" active="{{task.status!=='FAILED'}}" stroke-width="8" color="#526DF5" />
    <view class="status-box"><view class="status-title">{{task.status==='FAILED'?'批改失败':statusMessage}}</view><view wx:if="{{task.status!=='FAILED'}}" class="status-description">{{processingDescription}}</view></view>
    <view wx:if="{{task.status==='FAILED' && viewerMode==='teacher' && homeworkImages.length}}" class="failed-image-card"><view class="failed-image-head"><view>学生上传图片</view><text>共 {{homeworkImages.length}} 张</text></view><view class="failed-photo-grid"><view wx:for="{{homeworkImages}}" wx:key="fileId" class="failed-photo-item" data-index="{{index}}" data-type="homework" data-url="{{item.tempUrl}}" bindtap="previewImage"><image wx:if="{{item.tempUrl && !item.loadFailed}}" src="{{item.tempUrl}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}" data-type="homework"/><view wx:else class="failed-image-unavailable">图片暂时无法加载</view><view class="failed-photo-label">第 {{item.index}} 张</view></view></view></view>
    <view wx:if="{{task.status==='FAILED' && viewerMode==='teacher' && answerImages.length}}" class="failed-image-card"><view class="failed-image-head"><view>标准答案图片</view><text>共 {{answerImages.length}} 张</text></view><view class="failed-photo-grid"><view wx:for="{{answerImages}}" wx:key="fileId" class="failed-photo-item" data-index="{{index}}" data-type="answer" data-url="{{item.tempUrl}}" bindtap="previewImage"><image wx:if="{{item.tempUrl && !item.loadFailed}}" src="{{item.tempUrl}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}" data-type="answer"/><view wx:else class="failed-image-unavailable">图片暂时无法加载</view><view class="failed-photo-label">第 {{item.index}} 张</view></view></view></view>
    <view wx:if="{{task.status==='FAILED'}}" class="failure"><view>失败原因：{{errorMessage||'系统处理任务时发生异常'}}</view><view>处理建议：{{errorSuggestion||'请稍后重新尝试'}}</view><view wx:if="{{failureId}}">错误编号：{{failureId}}</view><button wx:if="{{retryable}}" class="secondary-button" bindtap="retry">重新尝试</button><button wx:if="{{failureCategory==='image'||failureCategory==='storage'}}" class="secondary-button" bindtap="retry">重新上传图片</button><view wx:if="{{!retryable}}" class="muted">请联系管理员并提供错误编号。</view></view>
  </view>
</view>
