.processing{min-height:100vh;padding-top:72rpx}.progress-card{padding:32rpx 28rpx;border-radius:24rpx}.task-name{overflow:hidden;color:var(--ui-text);font-size:38rpx;font-weight:700;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.progress-row{display:flex;align-items:baseline;justify-content:space-between;margin-top:34rpx}.progress-label{color:#475569;font-size:27rpx;font-weight:600}.progress-number{color:var(--ui-primary);font-size:46rpx;font-weight:700;line-height:1}.progress-bar{width:100%;margin-top:18rpx}.status-box{margin-top:30rpx;padding:22rpx;border-radius:18rpx;background:#f6f7ff}.status-title{color:#334155;font-size:30rpx;font-weight:700;line-height:1.45;word-break:break-all}.status-description{margin-top:10rpx;color:var(--ui-muted);font-size:26rpx;line-height:1.65;word-break:break-all}.failure{margin-top:24rpx;padding:22rpx;border-radius:18rpx;background:#fef2f2;color:#991b1b;line-height:1.75;word-break:break-all}.failure .secondary-button{width:100%;margin-top:18rpx}
.failed-image-card{margin-top:24rpx;padding:22rpx;border-radius:18rpx;background:#fff}.failed-image-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx;color:#64748b;font-size:24rpx}.failed-image-head view{color:#334155;font-size:28rpx;font-weight:700}.failed-photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.failed-photo-item{position:relative;overflow:hidden;border-radius:16rpx;background:#f2f4f8}.failed-photo-item image,.failed-image-unavailable{display:block;width:100%;height:172rpx;background:#eef1f5}.failed-image-unavailable{display:flex;align-items:center;justify-content:center;padding:12rpx;color:#7c879b;text-align:center;font-size:22rpx;box-sizing:border-box}.failed-photo-label{position:absolute;right:0;bottom:0;left:0;padding:8rpx 0;background:rgba(20,29,45,.63);color:#fff;text-align:center;font-size:21rpx}
