.upload-page{min-height:100vh}.upload-card{padding:28rpx;border-radius:24rpx}.upload-card+.upload-card{margin-top:24rpx}.card-header{display:flex;align-items:center;justify-content:space-between}.count-tag{padding:7rpx 16rpx;border-radius:999rpx;background:#eef1ff;color:var(--ui-primary);font-size:24rpx;font-weight:700}.textarea{width:100%;height:120rpx;margin-top:20rpx;padding:18rpx 20rpx;box-sizing:border-box;border:2rpx solid var(--ui-line);border-radius:18rpx;background:#fbfcff;font-size:27rpx;line-height:1.5}.grid{display:flex;flex-wrap:wrap;gap:20rpx;margin-top:22rpx}.image-item,.thumb-wrap,.thumb,.add{width:198rpx}.thumb-wrap,.thumb,.add{height:198rpx}.thumb-wrap{position:relative}.thumb,.add{display:block;border-radius:18rpx}.thumb{background:#f1f5f9}.delete-image{position:absolute;top:-12rpx;right:-12rpx;z-index:1;width:42rpx;height:42rpx;border-radius:50%;background:#ef4444;color:#fff;font-size:36rpx;line-height:38rpx;text-align:center;box-shadow:0 2rpx 8rpx rgba(0,0,0,.2)}.image-actions{display:flex;gap:16rpx;margin-top:10rpx;color:#64748b;font-size:24rpx}.add{display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box;border:2rpx dashed #a9bafc;background:#f6f7ff;color:var(--ui-primary)}.add-symbol{font-size:58rpx;font-weight:300;line-height:1}.upload-empty{margin-top:8rpx;font-size:24rpx;color:#7c879c}.upload-progress{min-height:38rpx;margin:18rpx 4rpx;color:var(--ui-muted);font-size:25rpx;line-height:1.5}.next-button{width:100%;margin-top:4rpx}
.crop-mask{position:fixed;z-index:99;inset:0;display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box;background:rgba(15,23,42,.76)}.crop-panel{width:100%;padding:24rpx;box-sizing:border-box;border-radius:24rpx;background:#fff}.crop-title{text-align:center;color:#1e293b;font-size:32rpx;font-weight:700}.crop-viewport{position:relative;overflow:hidden;height:760rpx;margin-top:22rpx;background:#0f172a;touch-action:none}.crop-preview{width:100%;height:100%}.crop-image{position:absolute;max-width:none}.crop-frame{position:absolute;box-sizing:border-box;border:2px solid #fff;box-shadow:0 0 0 2000px rgba(15,23,42,.46)}.crop-handle{position:absolute;z-index:2;width:28rpx;height:28rpx;border-radius:50%;background:#fff;border:3rpx solid #4f6ef7}.crop-handle-tl{left:-14rpx;top:-14rpx}.crop-handle-tr{right:-14rpx;top:-14rpx}.crop-handle-bl{left:-14rpx;bottom:-14rpx}.crop-handle-br{right:-14rpx;bottom:-14rpx}.crop-handle-top{left:50%;top:-14rpx;margin-left:-14rpx}.crop-handle-right{right:-14rpx;top:50%;margin-top:-14rpx}.crop-handle-bottom{bottom:-14rpx;left:50%;margin-left:-14rpx}.crop-handle-left{left:-14rpx;top:50%;margin-left:-14rpx}.crop-actions{display:flex;gap:20rpx;margin-top:24rpx}.crop-actions button{flex:1;margin:0;font-size:28rpx}.crop-original{background:#eef1ff!important;color:#3852c7!important}.crop-confirm{background:#4f6ef7!important;color:#fff!important}.crop-canvas{position:fixed;left:-9999px;top:-9999px}
